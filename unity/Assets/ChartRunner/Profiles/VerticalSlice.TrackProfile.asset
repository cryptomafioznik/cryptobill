    knownDefect: "\u0418\u041D\u0412\u0415\u0420\u0422\u0418\u0420\u041E\u0412\u0410\u041D\u041D\u0410\u042F
      \u041A\u0420\u0418\u0412\u0410\u042F: \u043E\u0431\u0443\u0447\u0430\u044E\u0449\u0430\u044F
      \u0441\u0435\u043A\u0446\u0438\u044F \u043D\u0430\u0441\u044B\u0449\u0430\u0435\u0442
      \u0436\u0451\u0441\u0442\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u043E\u0432
